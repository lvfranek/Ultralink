# =============================================================================
# Ultralink — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard
# Found in: Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Found in: Project Settings → API → service_role (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Resend — https://resend.com/api-keys
# Create an API key with "Sending" permission.
# Also add and verify your sending domain (ultralink.bio) in Resend → Domains.
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Site URL — the single source of truth for absolute URLs the app builds:
# Stripe Checkout/Portal redirects, sign-out, team invite emails, and
# in-app share/preview links. Read via src/lib/site-url.ts (getSiteUrl()).
# Must be set at BUILD time (it's inlined into the bundle since it's a
# NEXT_PUBLIC_ var) — set it in Vercel before the build step runs, not just
# as a runtime env var.
# Development: http://localhost:3000
# Production:  https://ultralink.bio
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Stripe — https://dashboard.stripe.com/apikeys
# Use test mode keys (sk_test_) for development.
# Webhook secret: create a webhook in Stripe Dashboard pointing at
#   https://<your-domain>/api/stripe/webhook
# or locally: stripe listen --forward-to localhost:3000/api/stripe/webhook
# Subscribe to: checkout.session.completed, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted,
#   invoice.payment_failed, invoice.payment_succeeded
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Stripe Price IDs — paste the price_id from each Stripe price you created.
# Each price must have metadata: { tier: "N", interval: "monthly"|"annual" }
# Tier corresponds to the number of link pages (1, 3, 10, 25, 50, 100, 200, 400)
# Annual prices are billed yearly at a ~25% discount.
# -----------------------------------------------------------------------------
STRIPE_PRICE_1_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_1_ANNUAL=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_3_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_3_ANNUAL=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_10_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_10_ANNUAL=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_25_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_25_ANNUAL=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_50_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_50_ANNUAL=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_100_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_100_ANNUAL=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_200_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_200_ANNUAL=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_400_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_400_ANNUAL=price_xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Admin visibility — Discord notifications + /admin dashboard
# -----------------------------------------------------------------------------
# Discord channel webhook URL (Channel Settings → Integrations → Webhooks).
# If unset, notifications silently no-op — signup/payment flows never fail.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# Webhook URLs for the in-app feedback form ("Report a bug" / "Feature request").
# Point these at separate Discord channels (e.g. #bugs, #feature-requests).
DISCORD_BUGS_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy
DISCORD_FEATURES_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# Your profile.id (UUID) from Supabase. Only this user can load /admin —
# everyone else gets a 404. If unset, /admin 404s for everyone.
ADMIN_USER_ID=00000000-0000-0000-0000-000000000000

# -----------------------------------------------------------------------------
# Imprint / legal contact — shown on /imprint and in the Privacy Policy.
# Server-only (no NEXT_PUBLIC_ prefix), so they never end up in the repo or the
# browser bundle. Set your real details in Vercel → Settings → Environment
# Variables. If NAME/STREET/CITY are unset, /imprint shows a "not configured"
# notice instead. PHONE and VAT_ID are optional.
# -----------------------------------------------------------------------------
IMPRINT_NAME=Your Name
IMPRINT_STREET=Example Street 1
IMPRINT_CITY=12345 Example City
IMPRINT_COUNTRY=Germany
IMPRINT_PHONE=
IMPRINT_VAT_ID=
